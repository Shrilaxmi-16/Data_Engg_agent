    "sql_result": {
      "status": "success",
      "confidence": "medium",
      "sql": "SELECT \n    c.c_nationkey AS nation_key,\n    SUM(o.o_totalprice) AS total_order_value,\n    COUNT(o.o_orderkey) AS order_count\nFROM \n    tpch.customer c\nJOIN \n    tpch.orders o ON c.c_custkey = o.o_custkey\nGROUP BY \n    c.c_nationkey\nORDER BY \n    c.c_nationkey;",
